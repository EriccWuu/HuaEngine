#include "HuaEngine/Generated/GeneratedReflection.h"

#include <algorithm>
#include <vector>

namespace {
    template<typename T>
    void Append(std::vector<T>& destination, std::span<const T> source) {
        destination.insert(destination.end(), source.begin(), source.end());
    }
}

namespace HE::Generated {
    std::span<const ReflectedTypeInfo> GetReflectedTypes() {
        static const auto values = [] {
            std::vector<ReflectedTypeInfo> result;
@HUA_META_APPEND_REFLECTED_TYPES@
            std::sort(result.begin(), result.end(), [](const auto& a, const auto& b) { return a.QualifiedName < b.QualifiedName; });
            return result;
        }();
        return values;
    }
    const ReflectedTypeInfo* FindReflectedType(std::string_view name) {
        for (const auto& value : GetReflectedTypes()) if (value.QualifiedName == name) return &value;
        return nullptr;
    }
    std::span<const ReflectedEnumInfo> GetReflectedEnums() {
        static const auto values = [] {
            std::vector<ReflectedEnumInfo> result;
@HUA_META_APPEND_REFLECTED_ENUMS@
            std::sort(result.begin(), result.end(), [](const auto& a, const auto& b) { return a.QualifiedName < b.QualifiedName; });
            return result;
        }();
        return values;
    }
    const ReflectedEnumInfo* FindReflectedEnum(std::string_view name) {
        for (const auto& value : GetReflectedEnums()) if (value.QualifiedName == name) return &value;
        return nullptr;
    }
    Ecs::Result<void> RegisterGeneratedComponents(Ecs::TypeRegistry& registry) {
        for (const auto& type : Refl::GetRuntimeTypes()) {
            if (!type.MakeEcsType) continue;
            auto registered = registry.Register(type.MakeEcsType());
            if (!registered) return registered.GetError();
        }
        return {};
    }
}

namespace HE::Refl {
    std::span<const RuntimeEnumDescriptor> GetRuntimeEnums() {
        static const auto values = [] {
            std::vector<RuntimeEnumDescriptor> result;
@HUA_META_APPEND_RUNTIME_ENUMS@
            std::sort(result.begin(), result.end(), [](const auto& a, const auto& b) { return a.QualifiedName < b.QualifiedName; });
            return result;
        }();
        return values;
    }
    const RuntimeEnumDescriptor* FindRuntimeEnum(std::string_view name) {
        for (const auto& value : GetRuntimeEnums()) if (value.QualifiedName == name) return &value;
        return nullptr;
    }
    std::span<const RuntimeTypeDescriptor> GetRuntimeTypes() {
        struct Storage {
            std::vector<RuntimeTypeDescriptor> Types;
            std::vector<std::vector<RuntimeFieldDescriptor>> Fields;
        };
        static const auto storage = [] {
            Storage result;
@HUA_META_APPEND_RUNTIME_TYPES@
            std::sort(result.Types.begin(), result.Types.end(), [](const auto& a, const auto& b) { return a.QualifiedName < b.QualifiedName; });
            result.Fields.reserve(result.Types.size());
            for (auto& type : result.Types) {
                auto& fields = result.Fields.emplace_back(type.Fields.begin(), type.Fields.end());
                for (auto& field : fields) {
                    if (field.EnumType) field.EnumType = FindRuntimeEnum(field.EnumType->QualifiedName);
                }
                type.Fields = fields;
            }
            return result;
        }();
        return storage.Types;
    }
    const RuntimeTypeDescriptor* FindRuntimeType(std::string_view name) {
        for (const auto& value : GetRuntimeTypes()) if (value.QualifiedName == name) return &value;
        return nullptr;
    }
    const RuntimeEnumValueDescriptor* FindRuntimeEnumValueByName(const RuntimeEnumDescriptor& type, std::string_view name) {
        for (const auto& value : type.Values) if (value.Name == name) return &value;
        return nullptr;
    }
    const RuntimeEnumValueDescriptor* FindRuntimeEnumValueByValue(const RuntimeEnumDescriptor& type, int64_t sought) {
        for (const auto& value : type.Values) if (value.Value == sought) return &value;
        return nullptr;
    }
}
