name: SandboxMaterial
material_type: Unlit
shader_path: Resources/shaders/sandbox.glsl
parameters:
  u_MainTexture:
    value_type: Texture2D
    value: texture_path_placeholder
  u_Color:
    value_type: Vec4
    value:
      w: 1.0
      x: 1.0
      y: 1.0
      z: 1.0
  u_TextureScale:
    value_type: Vec2
    value:
      x: 1.0
      y: 1.0
texture_slots:
  u_MainTexture: 0
